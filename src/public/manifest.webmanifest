{
  "id": "/",
  "name": "BingeKeeper",
  "short_name": "BingeKeeper",
  "description": "Track your favorite shows across streaming services and get reminded when new episodes or seasons are released.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#0f0f13",
  "theme_color": "#6c63ff",
  "orientation": "portrait-primary",
  "categories": ["entertainment", "productivity"],
  "icons": [
    {
      "src": "/images/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/images/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/images/icons/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/images/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/images/dashboard-preview.png",
      "sizes": "1365x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "BingeKeeper dashboard preview"
    }
  ],
  "prefer_related_applications": false
}
